int LoadParaList(char *flist)
{	
	int ii,ij,ik,inum,idim,isampledim;
	FILE *fp, * fptemp;
	HTKheader strHeader;
	
	char filename[500];

	int ifilenum, ilen, itmp, iframenum, icur, isample; 	//maybe long long
	float ** buffer;

	idim = p->iVectorSize;
	
	//time_t ltime;
	//time( &ltime );
//	printf( "Loading start:\t\t%s", ctime( &ltime ) );	
	// open the file list
	if ((fp = fopen(flist, "rt")) == NULL) {
		printf("fail to open file %s\n", flist);return -1;}
		
		iframenum = 0;
		ifilenum  = 0;
		while (!feof(fp))
		{
			if ( fscanf(fp, "%s",  filename) == EOF ){
				break;
			}
			if ( (fptemp = fopen(filename, "rb")) == NULL ) {
				printf("fail to open file %s %d\n", filename, ifilenum ); return -1;
			}
			if ( (LONG_MAX - iframenum) < 1e3  ) {
				printf("iframenum - %l overflow!\n", iframenum ); return -1;
			}
			fread(&strHeader, sizeof(HTKheader), 1, fptemp);
			ilen = ftell(fptemp);
			fclose(fptemp);
			
			itmp = (int) ( ilen - sizeof(HTKheader) ) / ( idim * sizeof(float) );
			if (strHeader.nSamples != itmp) {
				printf("feature %s len and header mismatch.\n", filename); return -1;}
			isampledim = (int) strHeader.sampleSize/sizeof(float);
			if (isampledim != idim) {
				printf("feature dim %d and model dim %d mismath.\n", isampledim, idim); return -1;}
			iframenum += itmp;
			ifilenum++;
		}
		if (ifilenum >= MAX_FILES){
			SayBye("Maximum files in file list is set to 20000");
		}
	
		
		// allocate a big buffer for reading all the feature files
		p->pparam = malloc(iframenum * sizeof(float *));
		buffer = p->pparam;
		for (ii = 0; ii < iframenum; ii++)
		{
			buffer[ii] = malloc(idim * sizeof(float));
			memset(buffer[ii], 0, sizeof(float) * idim);
		}
		
		rewind(fp);
		icur =0;
		for (ii = 0; ii < ifilenum; ii++)
		{
			fscanf(fp, "%s",  filename);
			if ( (fptemp = fopen(filename, "rb")) == NULL ) {
				printf("fail to open file %s %d\n", filename, ifilenum ); return -1;
			}
			fread(&strHeader, sizeof(HTKheader), 1, fptemp);
			isample = strHeader.nSamples;
			for (ij = 0; ij < isample; ij++)
			{
				fread(&buffer[icur], sizeof(float), idim, fptemp);
				icur++;
			}
			fclose(fptemp);
		}
		
		//time( &ltime );
		//printf( "Loading OK:\t\t%s", ctime( &ltime ) );

		p->iFrames = iframenum;
		if (ifilenum!=0){
			p->bPLoaded = true;
		}

		return ifilenum;
}

//---------------------------------------------------------------
// Get the nearest mean vector to the given vector according to
// Euclidean distance.
//    fvector : Vector to calculate
//        err : minimal distance
// Return Value:
//    1 : Success
//    0 : Nothing to calculate
int VQNearest(float *fvector, double *err)
{
	if (!p->bMLoaded || !p->bPLoaded){
		LookOut("Model or Param not loaded yet");return 0;
	}

	int ii,ij,imin = 0;
	double dtmp = 0;	// buffer to accumulate distances
	
	*err = DBL_MAX;
	for (ii = 0; ii < p->iNumMixtures; ii++)
	{
		dtmp = 0;
		for (ij = 0; ij < p->iVectorSize; ij++)
		{
			dtmp += (fvector[ij] - p->dMean[ii][ij] ) * (fvector[ij] - p->dMean[ii][ij] ) / p->dCovar[ii][ij];
		}
		if (dtmp < *err)
		{
			*err = dtmp;
			imin = ii;
		}
	}
	return imin;
}


//------------------------------------------------------------------
// Check if any mean vector (core) are not assigned any vectors, if
// yes, delete this one and divide the most populated one into two
// cores.
// Return Value:
//   1 : Success
//   0 : Model or Param not loaded yet
//  -1 : Not enough training data
int VQCheckZero(int *counter)
{
	if (!p->bMLoaded || !p->bPLoaded){
		LookOut("Model or Param not loaded yet");return 0;}

	int ii,ij,opti,optc;
	double amp=0.0001;
	float minimum; // threshold for smallest mixture
	
	minimum = p->iFrames / p->iNumMixtures * 0.02; // should be more than 2% of the average.
	for (ii = 0; ii < p->iNumMixtures; ii++)
	{
		if (counter[ii] <= minimum)
		{
			// find the largest mixture
			optc = 0;
			for (ij=0, optc=0; ij < p->iNumMixtures; ij++)
			{
				if (counter[ij] > optc)
				{
					optc = counter[ij];
					opti = ij;
				}
			}

			for (ij = 0; ij < p->iVectorSize; ij++)
			{
				//update the smallest mixture
				p->dMean[ii][ij] = p->dMean[opti][ij] + (amp* ((double)(rand()%10000)/10000.-.5));
				p->dCovar[ii][ij] = p->dCovar[opti][ij];

				//split the largest mixture
				p->dMean[opti][ij] += amp* ((double)(rand()%10000)/10000.-.5);
			}

			//update weights
			counter[ii] += (int)(counter[opti]*0.5);
			counter[opti] -= (int)(counter[opti]*0.5);
		}
	}
	
	return 1;
}


//--------------------------------------------------------------------
// Init the model for EM by VQ
//   MaxLoop :  Max loop of VQ iterations
// Return Value:
//   1 : Success
int InitMdl(int MaxLoop)
{
	int ii,ij,imin,sum;
	double tstep=0.8;		//the step of temperature decreasing
	
	double lastrubbish,rubbish; // 
	double threhold=1e-5;		// for convergence
	int ct=0;					// loop times

	double dtmp;
	
	double *dmean;			// global mean 
	double **dcore;			// temperary core
	int *iCount;			// counter of the assigned frames for each mixture
	int iframenum = p->iFrames;
	int idim = p->iVectorSize;
	int imix = p->iNumMixtures;

	if (!p->bMLoaded || !p->bPLoaded)
		SayBye("Model or Param not loaded");

	if (p->iFrames / p->iNumMixtures < 30)
		SayBye("Too few training data [AVG < 30]");
	
	iCount      = malloc(imix * sizeof(int));
	dcore       = malloc(imix * sizeof(double*));
	dmean 	= malloc(idim * sizeof(double));
	for (ii = 0; ii < p->iNumMixtures; ii++)
		dcore[ii] = malloc(idim * sizeof(double));

	if (!VQInit())
		SayBye("VQInit not succeed");

	printf(" - Initializing ... \n");
	rubbish = 0;
	
	// get the varFloor
	for (ij = 0; ij < p->iVectorSize; ij++) // for all frames
	{
		dmean[ij] = 0;
		p->dVarFloor[ij] = 0;
		for (ii = 0; ii < p->iFrames; ii++)
		{
			dmean[ij] += p->pparam[ii][ij] / p->iFrames;
			p->dVarFloor[ij] += p->pparam[ii][ij] * p->pparam[ii][ij] / p->iFrames;
		}
		p->dVarFloor[ij] -= dmean[ij] * dmean[ij];
		p->dVarFloor[ij] *= VAR_FLOOR;	// * 0.01
	}
	
	do
	{
		lastrubbish=rubbish;
		//-- clean up core
		for (ii = 0; ii < p->iNumMixtures; ii++)
		{
			for (ij = 0; ij < p->iVectorSize; ij++)
			{
				dcore[ii][ij] = 0;
				p->dCovar[ii][ij] = 0;
			}
			iCount[ii] = 0;
		}
		
		rubbish = 0;
		for (ii = 0; ii < p->iFrames; ii++) // for all frames
		{
			imin = VQNearest(&p->pparam[ii], &dtmp);
			// sum the err
			rubbish += dtmp;
			for (ij = 0; ij < p->iVectorSize; ij++)
			{
				dcore[imin][ij] += p->pparam[ii][ij];
				p->dCovar[imin][ij] += p->pparam[ii][ij] * p->pparam[ii][ij];
			}
			iCount[imin] ++;
		}
		rubbish /= p->iFrames;
		// recalculate the core
		for (ii = 0; ii < p->iNumMixtures; ii++)
		{
			if (iCount[ii] != 0)
			{
				for (ij = 0; ij < p->iVectorSize; ij++)
				{
					p->dMean[ii][ij] = dcore[ii][ij] / iCount[ii];
					p->dCovar[ii][ij] = p->dCovar[ii][ij] / iCount[ii] - p->dMean[ii][ij] * p->dMean[ii][ij];
					if (p->dCovar[ii][ij] < p->dVarFloor[ij]) {
						p->dCovar[ii][ij] = p->dVarFloor[ij]; 
					} 
				}
			}
		}
		
		//-- check for the non-assigned core
		VQCheckZero(iCount);
		
		printf("   - Loop: %d ,  Residual: %f ,  Increment: %f\n", ct, rubbish, lastrubbish-rubbish);
		ct++;
	}while( (fabs((lastrubbish-rubbish)/(0.01+lastrubbish)) >threhold) && (ct<MaxLoop) );

	printf("Init - OK!\n");

	// Update weight
	for (ii=0,sum=0; ii< p->iNumMixtures; ii++)
	{
		if (iCount[ii]==0)
			SayBye("Too few training data");
		sum += iCount[ii];
	}	
	for (ii = 0; ii < p->iNumMixtures; ii++){
		p->dMixtureWeight[ii] = iCount[ii] / (float)sum;
	}
	
	UpdateRest();
	
	for (ii = 0; ii < p->iNumMixtures; ii++)
		free( dcore[ii] );
	free( dcore );
	free (dmean);
	free( iCount );
	return 1;	

}

