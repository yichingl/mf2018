int loadgmmset1(char *fname)
{
	char *cTags[TAG_CUS_NUM] = {
			"NAME",		// 0
			"VECSIZE",	// 1
			"DIAG",		// 2
			"NUMMIXES",	// 3
			"MIXTURE",	// 4
			"MEAN",		// 5
			"VARIANCE",	// 6
			"ENDGMM" };	// 7

	char ctag[MAX_CUS_TAG];
	int iflag;
	FILE *fp;
	int ii;

	int iCurMixture=0;

	bool bNAME     = false;
	bool bVECSIZE  = false;
	bool bDIAG     = false;
	bool bNUMMIXES = false;
	int  iMEAN     = -1;
	int  iVAR      = -1;
	
	if ((fp=fopen(fname,"rt"))==NULL)
		return -1;

	while ( (iflag = GetNextTag(fp,ctag)) == 1)
	{
		for (ii=0;ii<TAG_CUS_NUM;ii++) {	if (strcmp(ctag,cTags[ii])==0) break; }
		switch (ii) {
			case 0:		// <NAME>
				if (bNAME) { sprintf(msg,"Duplicated TAG <%s> in %s",ctag,fname); SayBye(msg); }

				fscanf(fp,"%s", p->cName);	// read name
				fscanf(fp,"%s", p->cParm);	// read parameter type

				bNAME = true;
				break;
			case 1:		// <VECSIZE>
				if (bVECSIZE) { sprintf(msg,"Duplicated TAG <%s> in %s",ctag,fname); SayBye(msg); } 
				if (!bNAME)	{ sprintf(msg,"Missing TAG <NAME> in %s",fname); SayBye(msg); }

				fscanf(fp,"%d",&p->iVectorSize);
				if (p->iVectorSize<=0) SayBye("Vector size should be positive");

				bVECSIZE = true;
				break;
			case 2:		// <DIAG>
				if (bDIAG) { sprintf(msg,"Duplicated TAG <%s> in %s",ctag,fname); SayBye(msg); } 
				if (!bVECSIZE) { sprintf(msg,"Missing TAG <VECSIZE> in %s",fname); SayBye(msg); }
				
				p->bDiag = true;
				bDIAG = true;
				break;
			case 3:		// <NUMMIXES>
				if (bNUMMIXES) { sprintf(msg,"Duplicated TAG <%s> in %s",ctag,fname); SayBye(msg); } 
				if (!bDIAG) { sprintf(msg,"Missing TAG <DIAG> in %s",fname); SayBye(msg); }

				fscanf(fp,"%d",&p->iNumMixtures);
				if (p->iNumMixtures<=0) SayBye("Mixture of Gaussian should be positive");
				if (p->iVectorSize<=0) SayBye("Vector size should be > 0");
				
				p->dLDet 			= (double *) malloc( p->iNumMixtures * sizeof(double) );
				p->dMixtureWeight	= (double *) malloc( p->iNumMixtures * sizeof(double) );
				p->dlgWeight		= (double *) malloc( p->iNumMixtures * sizeof(double) );
				p->dMean 		= (double **) malloc( p->iNumMixtures * sizeof(double *) );
				p->dnVar	 		= (double **) malloc( p->iNumMixtures * sizeof(double *) );
				p->dCovar 		= (double **) malloc( p->iNumMixtures * sizeof(double *) );
				for (ii=0;ii<p->iNumMixtures;ii++)
				{
					p->dMean[ii]	= (double *) malloc( p->iVectorSize * sizeof(double) );
					p->dCovar[ii]	= (double *) malloc( p->iVectorSize * sizeof(double) );
					p->dnVar[ii]	= (double *) malloc( p->iVectorSize * sizeof(double) );
				}
				p->dVarFloor		= (double *) malloc( p->iVectorSize * sizeof(double) );

				bNUMMIXES = true;
				break;
			case 4:		// <MIXTURE> - read in the value one by one
				if (!bNUMMIXES) { sprintf(msg,"Missing TAG <NUMMIXES> in %s",fname); SayBye(msg); }

				fscanf(fp,"%d", &iCurMixture);
				fscanf(fp,"%lf", p->dMixtureWeight + iCurMixture);
				p->dlgWeight[iCurMixture] = log(p->dMixtureWeight[iCurMixture]);
				if ( iCurMixture!=(iMEAN+1) || iCurMixture!=(iVAR+1) )
					{ sprintf(msg,"Wrong <%s> index in %s",ctag,fname); SayBye(msg); } 
				break;
			case 5:		// <MEAN>
				iMEAN ++;
				if (iMEAN != iCurMixture) { sprintf(msg,"Wrong <MIXTURE> index in %s",fname); SayBye(msg); } 

				for (ii=0; ii< p->iVectorSize; ii++)
					fscanf(fp,"%lf",&p->dMean[iCurMixture][ii]);
				break;
			case 6:		// <VARIANCE>
				iVAR ++;
				if (iVAR != iCurMixture) { sprintf(msg,"Wrong <MIXTURE> index in %s",fname); SayBye(msg); } 

				p->dLDet[iCurMixture] = .0;
				for (ii=0;ii<p->iVectorSize;ii++)
				{
					fscanf(fp,"%lf",&p->dCovar[iCurMixture][ii]);
					p->dnVar[iCurMixture][ii] = 1.0 / p->dCovar[iCurMixture][ii];
					p->dLDet[iCurMixture] += log(p->dCovar[iCurMixture][ii]);
				}
				break;
			case 7:		// <ENDGMM>
				break;
			default:
				sprintf(msg,"Unknown TAG \"%s\"",ctag);
				LookOut(msg);
		}
	}
	if (iflag == 0)
	{
		sprintf(msg,"Unsolved TAG in \"%s\"",fname);
		SayBye(msg);
	}
	fclose(fp);
	// check integraty
	if ( ! (bNAME					// found <NAME> tag
		&& bVECSIZE					// found <VECSIZE> tag
		&& bDIAG					// found <DIAG> tag
		&& bNUMMIXES				// found <NUMMIXES> tag
		&& (iMEAN==p->iNumMixtures-1)	// means loaded
		&& (iVAR ==p->iNumMixtures-1)) )	// covariances loaded
	{
		sprintf(msg,"Format Error in %s",fname);
		SayBye(msg);
	}

	p->bMLoaded = true;

	return 1;
}


//--------------------------------------------------------------
// Free model's memory before exit
int CleanUpMdl()
{
	int ii;

	if (!p->bMLoaded)
		return 0;
	for (ii = 0; ii < p->iNumMixtures; ii++)
	{ // for each stream
		free( p->dMean[ii] );
		free( p->dCovar[ii] );
		free( p->dnVar[ii] );
		//free( dTrans[ii];
	}
	//free( dTrans );
	free( p->dMean );
	free( p->dCovar );
	free( p->dLDet );
	free( p->dMixtureWeight  );
	free( p->dlgWeight );
	free( p->dnVar );
	free( p->dVarFloor );

	p->bMLoaded = false;
	return 1;
}

//-------------------------------------------------------------------
// Free the parameter's memoroy
int CleanUpPar()
{
	int ii;

	if (!p->bPLoaded)
		return 0;

	free(p->pparam);

	p->bPLoaded = false;
	return 1;
}

//-------------------------------------------------------------------
// Get Next Tag from 'fp', tag stored in 'ctag'
// Return Value:
//      0 : Unresolved TAG
//      1 : Success
//     -1 : End of file
int GetNextTag(FILE *fp, char *ctag)
{
	int ii;
	char ch;

	while (!feof(fp))
	{
		ch=getc(fp);
		if (ch!='<')
			continue;
		// ch = '<'
		ii=0;
		while ((ctag[ii]=getc(fp))!='>' && ii<MAX_CUS_TAG) ii++;
		if (ii>=MAX_CUS_TAG)
			return 0;
		ctag[ii]=0;
		return 1;
	}
	return -1;
}

//------------------------------------------------------------------
// Write GMM definition to *fname in ASC
// Return Value :
//    1 :  Success
//    0 :  No data to write
//   -1 :  error
int WriteGMMSet(char *fname)
{
	int ii,ij;
	FILE *fp;

	if (!p->bMLoaded)
		return 0;

	if ((fp=fopen(fname,"w"))==NULL) {
		printf("cannot open %s for write.\n", fname);	return -1;}

		fprintf(fp,"<NAME> %s %s\n", p->cName, p->cParm);
		fprintf(fp,"<VECSIZE> %d", p->iVectorSize);
	if (p->bDiag)
		fprintf(fp," <DIAG>");
	fprintf(fp, "\n");
	fprintf(fp, "<NUMMIXES> %d\n", p->iNumMixtures);
	for (ii = 0; ii < p->iNumMixtures; ii++)
	{
		fprintf(fp, "<MIXTURE> %d %E\n", ii, p->dMixtureWeight[ii]);
		fprintf(fp, " <MEAN> \n");
		for (ij = 0; ij < p->iVectorSize; ij++)
			fprintf(fp, "  %E", p->dMean[ii][ij]);
		fprintf(fp, "\n");
		fprintf(fp, " <VARIANCE> \n");
		for (ij = 0; ij < p->iVectorSize; ij++)
			fprintf(fp, "  %E", p->dCovar[ii][ij]);
		fprintf(fp,"\n");
	}
	fprintf(fp, "<ENDGMM>\n");
	fclose(fp);

	return 1;
}

//---------------------------------------------------------------------
// Euclidean Distance
// (alternative: pre-calculate the total variance of each feature, 
// then weighting each feature with the variance)
double VQDistortion(float *vec1, double *vec2)
{
	int i;
	double result=0;
	for (i = 0; i < p->iVectorSize; i++)
		result += (vec1[i]-vec2[i]) * (vec1[i]-vec2[i]);
	return result;
}


//-----------------------------------------------------------------
// Init the mean vectors of VQ procedure
// Return Value:
//   1 :  Success
//   0 :  Nothing to init
int VQInit()
{
	int ii,ij;
	double amp=0.001;
	int *iCount = malloc(p->iNumMixtures * sizeof(int));
	// check if the model and the param have been loaded
	if (!p->bMLoaded || !p->bPLoaded){
		LookOut("Model or Param not loaded yet");return 0;}

	for (ii = 0; ii < p->iNumMixtures; ii++)
	{
		for (ij = 0; ij < p->iVectorSize; ij++)
		{
			p->dMean[ii][ij]  = 0;
			p->dCovar[ii][ij] = 0;
		}
		iCount[ii] = 0;
	}

	for (ii=0; ii < p->iFrames; ii++)
	{
		for (ij=0; ij < p->iVectorSize; ij++)
		{
			p->dMean[ii % p->iNumMixtures][ij]  += p->pparam[ii][ij];
			p->dCovar[ii % p->iNumMixtures][ij] += p->pparam[ii][ij] * p->pparam[ii][ij];
		}
		iCount[ii % p->iNumMixtures] ++ ;
	}

	for (ii = 0; ii < p->iNumMixtures; ii++)
	{
		for (ij = 0; ij < p->iVectorSize; ij++)
		{
			p->dMean[ii][ij]  /= iCount[ii];
			p->dCovar[ii][ij] /= iCount[ii];
			p->dCovar[ii][ij] -= p->dMean[ii][ij] * p->dMean[ii][ij];
		}
	}

	free( iCount );

	return 1;
}

