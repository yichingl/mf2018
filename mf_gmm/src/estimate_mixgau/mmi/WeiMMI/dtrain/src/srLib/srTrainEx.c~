// EM algorithm
int ReesMdl(int MaxLoop)
{
	int ii,ij,ik,iloop;
	double dlogfrmprob;
	double *dsumgama,*dlogmixw;
	double *dgama;
	double rubbish,lastrubbish;
	const double threshold = 1e-5;

	double *dmixw;		// A copy of mixture weights
	double **dmean;		//           mean values
	double **dvar;		//           and covariances

	int imix = p->iNumMixtures;
	int idim = p->iVectorSize;
	int iframenum = p->iFrames;
	
	// alloc memory
	dmean = malloc(imix * sizeof(double *));
	dvar  = malloc(imix * sizeof(double *));
	for (ii = 0; ii < p->iNumMixtures; ii++)
	{
		dmean[ii] = malloc(idim * sizeof(double));
		dvar[ii]  = malloc(idim * sizeof(double));
	}

	dmixw = malloc(imix * sizeof(double));
	dlogmixw = malloc(imix * sizeof(double));
	dgama = malloc(imix * sizeof(double));
	dsumgama = malloc(imix * sizeof(double));
	
	// main procedure >>
	rubbish = .0;
	iloop   = 0;
	printf(" - Re-estimating ... \n");
	do {
		lastrubbish = rubbish;
		rubbish = .0;
		//-----------------------------------------------
		// E-step
		//-----------------------------------------------
		for (ii = 0; ii < p->iNumMixtures; ii++)
		{
			// clean up temporary values
			dmixw[ii] = dsumgama[ii] = .0;
			for (ij = 0; ij < p->iVectorSize; ij++)
				dmean[ii][ij] = dvar[ii][ij] = .0;
		}
		
		for (ii = 0; ii< p->iFrames; ii++)
		{
			dlogfrmprob = LOGZERO; // log scale probability of a given frame
			for (ij = 0; ij < p->iNumMixtures; ij++)
			{
				dgama[ij]   = LMixProb(&p->pparam[ii], ij);
				dgama[ij]  += p->dlgWeight[ij];
				dlogfrmprob = LogAdd(dgama[ij], dlogfrmprob);
			}
			rubbish += dlogfrmprob;	// sum the rubbish
			
			for (ij = 0; ij < p->iNumMixtures; ij++)
			{
				dgama[ij] -= dlogfrmprob;
				dgama[ij]  = exp( dgama[ij] );

				// for updating weights
				dmixw[ij] += dgama[ij];
				dsumgama[ij]  += dgama[ij];
				// for updating mean & covariance
				for (ik = 0; ik < p->iVectorSize; ik++)
				{					 
					dmean[ij][ik] += dgama[ij] * p->pparam[ii][ik];					
					dvar[ij][ik] += dgama[ij] * p->pparam[ii][ik] * p->pparam[ii][ik];
				}
			}
		}
		rubbish /= p->iFrames;
		
		//-----------------------------------------------
		// M-step
		//-----------------------------------------------
		// update weight, mean & covariance
		for (ii = 0; ii < p->iNumMixtures; ii++)
		{
			p->dMixtureWeight[ii] = dmixw[ii] / p->iFrames;
			for (ij = 0; ij < p->iVectorSize; ij++)
			{
				p->dMean[ii][ij] = dmean[ii][ij] / dsumgama[ii];
				p->dCovar[ii][ij]  = dvar[ii][ij] / dsumgama[ii];
				p->dCovar[ii][ij] -= p->dMean[ii][ij] * p->dMean[ii][ij];
				// check variance
				if (p->dCovar[ii][ij] < p->dVarFloor[ij]) {
					p->dCovar[ii][ij] = p->dVarFloor[ij]; 
				}
			}
		}
		// update determinate
		UpdateRest();

		iloop ++;
		printf("   - loop: %d ,  Average Log Likelihood: %f ,  Increment: %f\n",iloop,rubbish,rubbish-lastrubbish);
	}while(fabs((rubbish-lastrubbish)/(lastrubbish+0.01))>threshold && iloop<MaxLoop);
	if (iloop>=MaxLoop)
		printf(" - Break at loop %d!\n",iloop);
	else
		printf(" - Converged at loop %d!\n",iloop);
	// main procedure <<
	for (ii = 0; ii < p->iNumMixtures; ii++)
	{
		free( dmean[ii] );
		free( dvar[ii] );
	}
	free( dmean );
	free( dvar );
	free( dmixw );
	free( dgama );
	free( dsumgama );
	free( dlogmixw );

	return 1;
}

//----------------------------------------------------------------
// Return the log likelihood of the given vector to the given
// mixture (the score should be multiplied with the mixture weight).
//    fparam :  pointer to the feature vector in float
//  MixIndex :  Mixture index
// Return Value:
//    The log-likelihood in double
double LMixProb(float *fparam, int MixIndex)
{
	int ii;
	double dsum,dtmp;
	const double dfloor   = 0;

	if (!p->bMLoaded)
		return .0;

	dsum = .0;
	for (ii = 0; ii < p->iVectorSize; ii++)
	{
		dtmp  = fparam[ii] - p->dMean[MixIndex][ii];
		//dsum += dtmp *dtmp / dCovar[MixIndex][ii];
		dsum += dtmp * dtmp * p->dnVar[MixIndex][ii];
	}
	dsum  = - p->iVectorSize * dlog2pi - p->dLDet[MixIndex] - dsum;
	dsum *= 0.5;
	return (dsum<LOGZERO? LOGZERO:dsum);
}


//--------------------------------------------------------------
// Recalculate the Determinant for each mixture after the covariance matrixes are changed.
// plus update the log weight and the inverse covarance
int UpdateRest()
{
	int ii,ij;
	
	for (ii = 0; ii < p->iNumMixtures; ii++)
	{
		p->dLDet[ii] = .0;
		for (ij = 0; ij < p->iVectorSize; ij++)
		{
			p->dnVar[ii][ij] = 1.0 / p->dCovar[ii][ij];
			p->dLDet[ii] += log(p->dCovar[ii][ij]);
		}

		if (p->dMixtureWeight[ii] <= 0)
			p->dlgWeight[ii] = LOGZERO;
		else
			p->dlgWeight[ii] = log(p->dMixtureWeight[ii]);
	}
	
	return 1;
}

